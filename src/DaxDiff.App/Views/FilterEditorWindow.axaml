<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:DaxDiff.Presentation.Resources"
        xmlns:vm="using:DaxDiff.Presentation.ViewModels"
        x:Class="DaxDiff.App.Views.FilterEditorWindow"
        x:DataType="vm:FilterEditorViewModel"
        Title="{Binding Title}" Width="980" Height="660" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CloudBrush}" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <!-- The selected filter's editor. -->
        <DataTemplate x:Key="FilterDetail" x:DataType="vm:FilterItemViewModel">
            <Border Classes="card">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel>
                                <Label Content="{x:Static res:Ui.Filter_LeftColumn}" Target="{Binding #LeftColumn}" />
                                <ComboBox x:Name="LeftColumn" ItemsSource="{Binding ColumnsA}" SelectedItem="{Binding LeftColumn}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="{x:Static res:Ui.Filter_RightColumn}" Target="{Binding #RightColumn}" />
                                <ComboBox x:Name="RightColumn" ItemsSource="{Binding ColumnsB}" SelectedItem="{Binding RightColumn}" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,4,0,4">
                            <TextBlock Text="{x:Static res:Ui.Filter_Type}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <Border Classes="segmentGroup" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Classes="segment" Content="{x:Static res:Ui.Filter_Basic}" IsChecked="{Binding IsBasic}" />
                                    <RadioButton Classes="segment" Content="{x:Static res:Ui.Filter_Advanced}" IsChecked="{Binding IsAdvanced}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
    
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Label Content="{x:Static res:Ui.Filter_Description}" Target="{Binding #Meaning}" />
                        <TextBox x:Name="Meaning" Text="{Binding Meaning}" />
                        <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding Issues, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
    
                    <Panel>
                        <!-- Basic filtering -->
                        <DockPanel IsVisible="{Binding IsBasic}">
                            <!-- "Is" follows "Is not": checking either radio unchecks the other, which updates Exclude. -->
                            <WrapPanel DockPanel.Dock="Top">
                                <RadioButton Content="{x:Static res:Ui.Filter_Is}" IsChecked="{Binding !Exclude, Mode=OneWay}" />
                                <RadioButton Content="{x:Static res:Ui.Filter_IsNot}" IsChecked="{Binding Exclude}" />
                            </WrapPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <ProgressBar DockPanel.Dock="Right" Width="60" MinWidth="0" Height="6" MinHeight="0" IsIndeterminate="True" Margin="8,0,0,8"
                                             IsVisible="{Binding IsLoading}" />
                                <TextBox Text="{Binding SearchText}" AutomationProperties.Name="{x:Static res:Ui.Filter_SearchValues}"
                                         ToolTip.Tip="{x:Static res:Ui.Filter_SearchValues}" PlaceholderText="{x:Static res:Ui.Filter_SearchValues}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ValuesStatus}" Foreground="{DynamicResource MutedText}" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                            <!-- Wraps, so longer labels (Swedish) move the manual entry to its own line instead of overlapping. -->
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                                    <Button Content="{x:Static res:Ui.Filter_SelectAllShown}" Command="{Binding SelectAllShownCommand}" />
                                    <Button Content="{x:Static res:Ui.Filter_Clear}" Command="{Binding ClearSelectionCommand}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                                    <TextBox Width="160" Text="{Binding ManualValue}" Margin="0"
                                             AutomationProperties.Name="{x:Static res:Ui.Filter_ValueToAdd}" ToolTip.Tip="{x:Static res:Ui.Filter_ValueToAddTip}"
                                             PlaceholderText="{x:Static res:Ui.Filter_TypeValue}" />
                                    <Button Content="{x:Static res:Ui.Filter_AddValue}" Command="{Binding AddManualValueCommand}" />
                                </StackPanel>
                            </WrapPanel>
                            <ListBox Classes="values" ItemsSource="{Binding Values}" AutomationProperties.Name="{x:Static res:Ui.Filter_Values}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilterValueItem">
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="0" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
    
                        <!-- Advanced filtering -->
                        <StackPanel IsVisible="{Binding IsAdvanced}">
                            <TextBlock Text="{x:Static res:Ui.Filter_ShowWhen}" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <Grid ColumnDefinitions="240,12,*">
                                <ComboBox ItemsSource="{Binding Condition1Options}" SelectedItem="{Binding Condition1}"
                                          AutomationProperties.Name="{x:Static res:Ui.Filter_Condition1}" />
                                <TextBox Grid.Column="2" Text="{Binding Condition1Value}" IsEnabled="{Binding Condition1NeedsValue}"
                                         AutomationProperties.Name="{x:Static res:Ui.Filter_Condition1Value}" />
                            </Grid>
                            <WrapPanel Margin="0,2,0,2">
                                <RadioButton Content="{x:Static res:Ui.Filter_And}" IsChecked="{Binding JoinAnd}" />
                                <RadioButton Content="{x:Static res:Ui.Filter_Or}" IsChecked="{Binding JoinOr}" />
                            </WrapPanel>
                            <Grid ColumnDefinitions="240,12,*">
                                <ComboBox ItemsSource="{Binding Condition2Options}" SelectedItem="{Binding Condition2}"
                                          AutomationProperties.Name="{x:Static res:Ui.Filter_Condition2}" />
                                <TextBox Grid.Column="2" Text="{Binding Condition2Value}" IsEnabled="{Binding Condition2NeedsValue}"
                                         AutomationProperties.Name="{x:Static res:Ui.Filter_Condition2Value}" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0"
                                       Text="{x:Static res:Ui.Filter_InputHint}" />
                        </StackPanel>
                    </Panel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- Form spacing for every field and button. -->
        <Style Selector="TextBox, ComboBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="WrapPanel > Button, WrapPanel > RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="ListBox.values ListBoxItem">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.values CheckBox">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Label">
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24,20">
        <!-- Apply / Cancel -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Spacing="8" Margin="16,0,0,0">
                <Button Content="{x:Static res:Ui.Filter_Cancel}" IsCancel="True" MinWidth="96" Click="Cancel_Click" />
                <Button Content="{x:Static res:Ui.Filter_Apply}" IsDefault="True" Click="Apply_Click" Classes="primary" MinWidth="96" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                       Text="{x:Static res:Ui.Filter_Intro}" />
        </DockPanel>

        <Grid ColumnDefinitions="290,20,*">
            <!-- Filter list -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Ui.Filter_ListTitle}" Classes="cardTitle" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="{x:Static res:Ui.Filter_Add}" Command="{Binding AddFilterCommand}" Classes="secondary" />
                    <Button Content="{x:Static res:Ui.Filter_Remove}" Command="{Binding RemoveFilterCommand}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                           Text="{x:Static res:Ui.Filter_ConnectFirst}" IsVisible="{Binding !ModelsConnected}" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{x:Static res:Ui.Filter_Filters}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilterItemViewModel">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis">
                                    <Run Text="A: " /><Run Text="{Binding LeftColumn, Mode=OneWay, TargetNullValue='–'}" />
                                    <Run Text="   B: " /><Run Text="{Binding RightColumn, Mode=OneWay, TargetNullValue='–'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Issues}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding Issues, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Selected filter -->
            <TextBlock Grid.Column="2" Text="{x:Static res:Ui.Filter_Empty}" Classes="pageHint" IsVisible="{Binding !HasSelection}" />
            <!-- Rebuilt for each selected filter (see code-behind), so radio groups and column lists never write into the previous one. -->
            <ContentControl x:Name="Detail" Grid.Column="2" IsVisible="{Binding HasSelection}" />
        </Grid>
    </DockPanel>
</Window>
