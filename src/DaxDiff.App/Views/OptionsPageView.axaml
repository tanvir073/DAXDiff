<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:DaxDiff.Presentation.Resources"
             xmlns:vm="using:DaxDiff.Presentation.ViewModels"
             x:Class="DaxDiff.App.Views.OptionsPageView"
             x:DataType="vm:OptionsPageViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="eyebrow" Text="{x:Static res:Ui.OptPage_Step}" />
            <TextBlock Classes="pageTitle" Text="{x:Static res:Ui.OptPage_Title}" />
            <TextBlock Classes="pageHint" Text="{x:Static res:Ui.OptPage_Hint}" />
            <Border Classes="card" Padding="20,14" Margin="0,0,0,14">
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Label Content="{x:Static res:Ui.OptPage_Picker}" Target="{Binding #Picker}" VerticalAlignment="Center" Padding="0" />
                    <ComboBox x:Name="Picker" Width="260" Margin="0,0,8,0" ItemsSource="{Binding Comparisons.Comparisons}"
                              SelectedItem="{Binding Comparisons.Selected}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComparisonEditorViewModel">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Classes="primary" Content="{x:Static res:Ui.Cmp_Save}" Command="{Binding Comparisons.Selected.SaveCommand}" />
                    <Button Content="{x:Static res:Ui.Cmp_Discard}" Command="{Binding Comparisons.Selected.DiscardChangesCommand}" />
                    <TextBlock Text="{Binding Comparisons.Selected.SaveStateText}" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <TextBlock Classes="pageHint" DockPanel.Dock="Top" Text="{x:Static res:Ui.OptPage_NoComparison}" IsVisible="{Binding !Comparisons.HasSelection}" />
        <ContentControl Content="{Binding Comparisons.Selected.Options}" Focusable="False" />
    </DockPanel>
</UserControl>
