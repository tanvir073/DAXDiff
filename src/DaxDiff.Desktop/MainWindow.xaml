<Window x:Class="DaxDiff.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DaxDiff.Desktop.ViewModels"
        xmlns:views="clr-namespace:DaxDiff.Desktop.Views"
        Title="{Binding WindowTitle}"
        Icon="Assets/DAXDiff.ico"
        Width="1360" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CloudBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="{StaticResource BaseFontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="F5" Command="{Binding Run.RunCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SourcesViewModel}"><views:SourcesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComparisonsViewModel}"><views:ComparisonsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptionsPageViewModel}"><views:OptionsPageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptionsViewModel}"><views:OptionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}"><views:RunView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><views:ResultsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

        <!-- Workflow step in the left menu: number circle, title and live status. -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource NavButton}" MinHeight="52"
                    Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                    IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Hint}"
                    AutomationProperties.Name="{Binding Title, StringFormat='Step {0}'}" AutomationProperties.HelpText="{Binding Status}">
                <DockPanel>
                    <Border x:Name="Circle" Width="26" Height="26" CornerRadius="13" BorderThickness="1" Margin="0,0,12,0"
                            BorderBrush="{DynamicResource StrongBorderBrush}" Background="Transparent" VerticalAlignment="Center">
                        <TextBlock x:Name="Number" Text="{Binding Step}" FontSize="12.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TealBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="Medium" />
                        <TextBlock x:Name="Status" Text="{Binding Status}" FontSize="12.5" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource ChipBrush}" />
                    <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource ChipBrush}" />
                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource ChipTextBrush}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                    <Setter TargetName="Status" Property="Opacity" Value="0.8" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource FieldBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working"><Setter Property="Fill" Value="{DynamicResource AccentDeepBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="20,10" MinHeight="60">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- "Outer join" mark: model A and model B as overlapping circles, the matched rows as the lens. -->
                    <Viewbox Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="DAXDiff logo">
                        <Canvas Width="100" Height="100">
                            <Ellipse Canvas.Left="8" Canvas.Top="22" Width="56" Height="56" Fill="{DynamicResource LogoABrush}" />
                            <Ellipse Canvas.Left="36" Canvas.Top="22" Width="56" Height="56" Fill="{DynamicResource LogoBBrush}" />
                            <Path Data="M50,25.75 A28,28 0 0 1 50,74.25 A28,28 0 0 1 50,25.75 Z" Fill="{DynamicResource LogoLensBrush}"
                                  Stroke="{DynamicResource HeaderBrush}" StrokeThickness="6" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <!-- Wordmark "DAX" regular + "DIFF" bold. WPF has no letter spacing, so the 0.06em tracking is a margin per letter. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="DAXDiff">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
                                <Setter Property="FontSize" Value="21" />
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
                                <Setter Property="Margin" Value="0,0,1.3,0" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="D" /><TextBlock Text="A" /><TextBlock Text="X" />
                        <TextBlock Text="D" FontWeight="Bold" /><TextBlock Text="I" FontWeight="Bold" /><TextBlock Text="F" FontWeight="Bold" /><TextBlock Text="F" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sa_ve" Command="{Binding SaveProjectCommand}" Style="{StaticResource LightButton}" ToolTip="Save the project (Ctrl+S)"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Save _as…" Command="{Binding SaveProjectAsCommand}" Style="{StaticResource LightButton}"
                            ToolTip="Save the project to a new file (Ctrl+Shift+S)"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Close" Command="{Binding CloseProjectCommand}" Style="{StaticResource LightButton}" ToolTip="Close the project"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
                    <Border Width="1" Height="24" Background="{DynamicResource HeaderLineBrush}" Margin="12,0,4,0"
                            Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="_Open project…" Command="{Binding OpenProjectCommand}" Style="{StaticResource LightButton}"
                            ToolTip="Open a project file (Ctrl+O)" />
                    <Button Command="{Binding NewProjectCommand}" Style="{StaticResource DarkPrimaryButton}" ToolTip="Create a new project file (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 6 0 V 12 M 0 6 H 12" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <AccessText Text="_New project" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Project name and save state -->
                <Border BorderBrush="{DynamicResource HeaderLineBrush}" BorderThickness="1,0,0,0" Margin="18,0,12,0" Padding="16,0,0,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="No project open" Foreground="{DynamicResource HeaderMutedBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ProjectPath}"
                                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource HeaderTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            <TextBlock Text=".pbicomp" Foreground="{DynamicResource HeaderMutedBrush}" Margin="0,0,14,0" />
                            <!-- Tick when saved, cyan dot when there are unsaved changes. -->
                            <Grid VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path Data="M 0 5 L 4 9 L 12 0" Stroke="{DynamicResource HeaderMutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="{Binding IsDirty, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentFillBrush}"
                                         Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Text="{Binding SaveStateText}" Foreground="{DynamicResource HeaderMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,6" TextElement.FontSize="12.5" TextElement.Foreground="{DynamicResource MutedText}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,18,0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"
                               Text="{Binding ErrorCount, StringFormat='{}{0} problem(s) in this comparison'}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding SourceA}" />
                    <TextBlock Text="{Binding SourceA.Identity, StringFormat='A: {0}'}" MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="0,0,18,0"
                               ToolTip="{Binding SourceA.Identity}" />
                    <Ellipse Style="{StaticResource StatusDot}" DataContext="{Binding SourceB}" />
                    <TextBlock Text="{Binding SourceB.Identity, StringFormat='B: {0}'}" MaxWidth="320" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourceB.Identity}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Margin="0,0,18,0" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="256" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0"
                Padding="12,18,12,12">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <Button Style="{StaticResource NavButton}" DataContext="{Binding SettingsNav}"
                            Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            ToolTip="{Binding Hint}" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3 20 V 13 M 3 9 V 2 M 11 20 V 11 M 11 7 V 2 M 19 20 V 15 M 19 11 V 2 M 0 13 H 6 M 8 7 H 14 M 16 15 H 22"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </Border>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" DataContext="{Binding HomeNav}"
                            Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                            ToolTip="{Binding Hint}" AutomationProperties.Name="Home">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0 8.5 L 9 1 L 18 8.5 M 2 7.5 V 19 H 16 V 7.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"
                                  Margin="0,0,12,0" />
                            <TextBlock Text="Home" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="PROJECT WORKFLOW" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource MutedText}" Margin="12,20,0,6" />
                    <ItemsControl ItemsSource="{Binding WorkflowNav}" ItemTemplate="{StaticResource StepTemplate}" Focusable="False" />

                    <DockPanel Margin="12,8,0,0" Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
                        <Path Data="M 1 8 H 13 V 16 H 1 Z M 4 8 V 5 A 3 3 0 0 1 10 5 V 8" Stroke="{DynamicResource MutedText}" StrokeThickness="1.6"
                              Width="13" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock Text="Open or create a project to unlock these steps" FontSize="12.5" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" Margin="32,26,32,20" Focusable="False" />
    </DockPanel>
</Window>
