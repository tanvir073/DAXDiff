<Window x:Class="DaxDiff.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DaxDiff.Desktop.ViewModels"
        xmlns:views="clr-namespace:DaxDiff.Desktop.Views"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SubtleBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewComparisonCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="F5" Command="{Binding Run.RunCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SourcesViewModel}"><views:SourcesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MappingViewModel}"><views:MappingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptionsViewModel}"><views:OptionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}"><views:RunView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><views:ResultsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Padding="12,8">
            <DockPanel>
                <TextBlock Text="DAXDiff" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="_New" Command="{Binding NewComparisonCommand}" ToolTip="New comparison (Ctrl+N)" Margin="0,0,6,0" />
                    <Button Content="_Open…" Command="{Binding OpenProjectCommand}" ToolTip="Open project (Ctrl+O)" Margin="0,0,6,0" />
                    <Button Content="Sa_ve" Command="{Binding SaveProjectCommand}" ToolTip="Save project (Ctrl+S)" Margin="0,0,6,0" />
                    <Button Content="Save _as…" Command="{Binding SaveProjectAsCommand}" ToolTip="Save project as (Ctrl+Shift+S)" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding ProjectName}" Foreground="#DDE6F0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="Mapping errors: " /><Run Text="{Binding ErrorCount, Mode=OneWay}" />
                    <Run Text="   A: " /><Run Text="{Binding SourceA.Identity, Mode=OneWay}" />
                    <Run Text="   B: " /><Run Text="{Binding SourceB.Identity, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <ListBox DockPanel.Dock="Left" Width="200" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                 BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}" Background="White"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Steps">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Hint}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl Content="{Binding CurrentPage}" Margin="16" Focusable="False" />
    </DockPanel>
</Window>
