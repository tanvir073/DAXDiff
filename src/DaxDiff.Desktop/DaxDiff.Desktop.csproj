<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DaxDiff.Presentation\DaxDiff.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DAXDiff</AssemblyName>
    <RootNamespace>DaxDiff.Desktop</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- "Outer join" logo: exe, taskbar and Start menu icon. -->
    <ApplicationIcon>Assets\DAXDiff.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Numberskills design system fonts (SIL Open Font License), static instances of the variable fonts. -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\DAXDiff.ico" />
  </ItemGroup>

</Project>
