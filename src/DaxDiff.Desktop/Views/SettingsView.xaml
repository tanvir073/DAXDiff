<UserControl x:Class="DaxDiff.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DaxDiff.Desktop.Resources;assembly=DaxDiff.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{x:Static res:Ui.Settings_Eyebrow}" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{x:Static res:Ui.Settings_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Static res:Ui.Settings_Hint}" Style="{StaticResource PageHint}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Settings_Appearance}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{x:Static res:Ui.Settings_AppearanceHint}" Style="{StaticResource Muted}"
                               FontSize="13" Margin="0,0,0,12" />
                    <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" BorderThickness="0" Padding="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static res:Ui.Settings_Theme}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Margin" Value="0,0,6,6" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="164" ToolTip="{Binding Description}">
                                    <!-- Miniature of the window in this theme: header, menu and a hero card. -->
                                    <Border Height="88" CornerRadius="10" BorderThickness="1" BorderBrush="{Binding Tokens.Strong, Converter={StaticResource CssBrush}}"
                                            Background="{Binding Tokens.Page, Converter={StaticResource CssBrush}}" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Background="{Binding Tokens.Header, Converter={StaticResource CssBrush}}" CornerRadius="9,9,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Tokens.Accent, Converter={StaticResource CssBrush}}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            </Border>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding Tokens.Surface, Converter={StaticResource CssBrush}}" BorderBrush="{Binding Tokens.Strong, Converter={StaticResource CssBrush}}" BorderThickness="0,0,1,0"
                                                        CornerRadius="0,0,0,9" />
                                                <StackPanel Grid.Column="1" Margin="8,8,8,0">
                                                    <Border Height="26" CornerRadius="5" Background="{Binding Tokens.Hero, Converter={StaticResource CssBrush}}">
                                                        <Border Width="26" Height="9" CornerRadius="4.5" Background="{Binding Tokens.Accent, Converter={StaticResource CssBrush}}"
                                                                HorizontalAlignment="Left" Margin="6,0,0,0" />
                                                    </Border>
                                                    <Border Height="22" CornerRadius="5" Margin="0,6,0,0" Background="{Binding Tokens.Surface, Converter={StaticResource CssBrush}}"
                                                            BorderBrush="{Binding Tokens.Strong, Converter={StaticResource CssBrush}}" BorderThickness="1" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,0,0" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedText}" Margin="2,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Settings_Language_Title}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{x:Static res:Ui.Settings_Language_Hint}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Label Content="{x:Static res:Ui.Settings_Language_Label}" Target="{Binding ElementName=LanguageBox}" />
                    <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                              HorizontalAlignment="Left" MinWidth="240" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Settings_SignInTitle}" Style="{StaticResource CardTitle}" />
                    <Border Style="{StaticResource Message}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SignInStatus}" TextWrapping="Wrap" FontSize="13" />
                    </Border>
                    <Label Content="{x:Static res:Ui.Settings_ClientId}" Target="{Binding ElementName=ClientId}" />
                    <TextBox x:Name="ClientId" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="{x:Static res:Ui.Settings_Tenant}" Target="{Binding ElementName=Tenant}" />
                    <TextBox x:Name="Tenant" Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{x:Static res:Ui.Settings_ClientIdHint}"
                               Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="{x:Static res:Ui.Settings_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="{x:Static res:Ui.Settings_SignOutAll}" Command="{Binding SignOutCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Settings_Privacy}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding PrivacyText}" TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Settings_Help}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{x:Static res:Ui.Settings_HelpHint}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="{x:Static res:Ui.Settings_UserGuide}" Command="{Binding OpenUserGuideCommand}" />
                        <Button Content="{x:Static res:Ui.Settings_ReportBug}" Command="{Binding ReportBugCommand}" />
                        <Button Content="{x:Static res:Ui.Settings_ReleaseNotes}" Command="{Binding OpenReleasesCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Settings_Diagnostics}" Style="{StaticResource CardTitle}" />
                    <TextBlock LineHeight="22">
                        <Run Text="{x:Static res:Ui.Settings_Version}" Foreground="{DynamicResource MutedText}" /><Run Text="{Binding Version, Mode=OneWay}" />
                        <LineBreak /><Run Text="{x:Static res:Ui.Settings_Runtime}" Foreground="{DynamicResource MutedText}" /><Run Text="{Binding Runtime, Mode=OneWay}" />
                        <LineBreak /><Run Text="{x:Static res:Ui.Settings_Logs}" Foreground="{DynamicResource MutedText}" /><Run Text="{Binding LogFolder, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{x:Static res:Ui.Settings_OpenLogs}" Command="{Binding OpenLogsCommand}" />
                        <Button Content="{x:Static res:Ui.Settings_Reset}" Command="{Binding ResetCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
