<UserControl x:Class="DaxDiff.Desktop.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,18">
                    <Button Content="_Cancel" Command="{Binding RunCancelCommand}" />
                    <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0 0 L 9 5.5 L 0 11 Z" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <AccessText Text="_Run (F5)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="STEP 4 OF 5" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Run" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageHint}"
                               Text="Tick the comparisons to run. Each runs in its last saved version, one after another, with both models queried in parallel. A cancelled or truncated run is never reported as complete." />
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                                <Button Content="All" Command="{Binding IncludeAllCommand}" MinHeight="30" Padding="12,0" Margin="0,0,6,0" />
                                <Button Content="None" Command="{Binding IncludeNoneCommand}" MinHeight="30" Padding="12,0" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="Comparisons to run" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Comparisons}" MaxHeight="170" AutomationProperties.Name="Comparisons to run">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RunStatusText}" Margin="12,0,0,0" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" ToolTip="{Binding RunStatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSaved}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IncludeInRun}" IsEnabled="{Binding IsSaved}" Margin="0" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Comparison scope" Style="{StaticResource CardTitle}" />
                        <DockPanel Margin="0,0,0,6">
                            <Border Style="{StaticResource SideChipA}" Margin="0,0,10,0" VerticalAlignment="Top"><TextBlock Text="A" /></Border>
                            <TextBlock Text="{Binding ScopeA}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource SideChipB}" Margin="0,0,10,0" VerticalAlignment="Top"><TextBlock Text="B" /></Border>
                            <TextBlock Text="{Binding ScopeB}" TextWrapping="Wrap" />
                        </DockPanel>
                        <Border Style="{StaticResource Message}">
                            <CheckBox IsChecked="{Binding AcknowledgedScope}" Margin="0" VerticalContentAlignment="Top">
                                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                           Text="I understand results are as observed by the current caller on each side. Row-level/object-level security and Desktop admin access can make rows differ, so missing keys are not necessarily model differences." />
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}">
                            <Run Text="Elapsed " /><Run Text="{Binding Elapsed, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Current}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" Height="6" Margin="0,10,0,4"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource QuietPanel}">
                            <DockPanel>
                                <Border Style="{StaticResource SideChipA}" Margin="0,0,10,0" VerticalAlignment="Top"><TextBlock Text="A" /></Border>
                                <TextBlock Text="{Binding StatusA}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource QuietPanel}">
                            <DockPanel>
                                <Border Style="{StaticResource SideChipB}" Margin="0,0,10,0" VerticalAlignment="Top"><TextBlock Text="B" /></Border>
                                <TextBlock Text="{Binding StatusB}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="Execution log" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Log}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" AutomationProperties.Name="Execution log" />
    </DockPanel>
</UserControl>
