<UserControl x:Class="DaxDiff.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Numbered step in the "How it works" strip. -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ChipTextBrush}" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="ReadinessRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1200" Margin="0,0,0,8">
            <!-- Hero -->
            <TextBlock Text="SEMANTIC MODEL COMPARISON" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Compare two Power BI semantic models" Style="{StaticResource PageTitle}" FontSize="36" />
            <TextBlock Style="{StaticResource PageHint}" FontSize="15" LineHeight="24" Margin="0,4,0,24"
                       Text="Pick model A and model B, choose the fields you care about and see every row and value that differs. Everything you set up is saved in one .pbicomp project file." />

            <!-- Ways in -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource FeatureCard}" Padding="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Background="{DynamicResource AccentFillBrush}"
                                TextElement.Foreground="{DynamicResource OnAccentBrush}" Margin="0,0,0,14">
                            <Path Style="{StaticResource IconPath}" Data="M 7 0 V 14 M 0 7 H 14" Width="16" Height="16" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="New project" FontFamily="{StaticResource DisplayFont}" FontSize="24" Margin="0,0,0,8" />
                        <Button DockPanel.Dock="Bottom" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0" Content="_Start new project" />
                        <TextBlock Text="Choose where to save the project file, then connect model A and model B and add one or more comparisons."
                                   TextWrapping="Wrap" Foreground="{DynamicResource HeroMutedBrush}" LineHeight="21" Margin="0,0,0,18" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource IconTile}" Margin="0,0,0,14">
                            <Path Style="{StaticResource IconPath}"
                                  Data="M 2 18 H 18 A 2 2 0 0 0 20 16 V 6 A 2 2 0 0 0 18 4 H 10 L 8 1 H 2 A 2 2 0 0 0 0 3 V 16 A 2 2 0 0 0 2 18 Z" />
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="Open project" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                   Foreground="{DynamicResource TealBrush}" Margin="0,0,0,8" />
                        <Button DockPanel.Dock="Bottom" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0" Content="_Browse files…" />
                        <TextBlock Text="Open a .pbicomp project to rerun or edit its comparisons. You reconnect to the models after opening."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" LineHeight="21" Margin="0,0,0,18" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Recent projects and connection readiness -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Recent projects" Style="{StaticResource CardTitle}" Margin="24,20,24,12" />
                        <TextBlock Text="No recent projects yet. Projects you create or open appear here." Foreground="{DynamicResource MutedText}"
                                   TextWrapping="Wrap" Margin="24,0,24,22">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Recent.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Path Style="{StaticResource IconPath}" Width="16" Height="18"
                                                      Data="M 10 0 H 2 A 2 2 0 0 0 0 2 V 18 A 2 2 0 0 0 2 20 H 14 A 2 2 0 0 0 16 18 V 6 Z M 10 0 V 6 H 16" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Content="Open" Margin="12,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}" AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}" />
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Folder}" FontSize="12.5" Foreground="{DynamicResource MutedText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Connection readiness" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                        <TextBlock Text="What each kind of source needs." Style="{StaticResource Muted}" FontSize="13" />

                        <DockPanel Style="{StaticResource ReadinessRow}">
                            <Path DockPanel.Dock="Left" Data="M 2 3 H 22 V 17 H 2 Z M 8 21 H 16 M 12 17 V 21" Stroke="{DynamicResource TealBrush}"
                                  StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="Power BI Desktop" FontWeight="SemiBold" />
                                <TextBlock Text="The file must be open in Power BI Desktop. DAXDiff never reads PBIX files offline." Style="{StaticResource Muted}"
                                           FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource ReadinessRow}">
                            <Path DockPanel.Dock="Left" Data="M 17.5 19 H 9 A 7 7 0 1 1 15.7 10 H 17.5 A 4.5 4.5 0 1 1 17.5 19 Z" Stroke="{DynamicResource TealBrush}"
                                  StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="Service over XMLA" FontWeight="SemiBold" />
                                <TextBlock Text="Premium, PPU or Fabric capacity with XMLA read, and Build permission. Each model signs in with its own account."
                                           Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource ReadinessRow}">
                            <Path DockPanel.Dock="Left" Data="M 3 5 A 9 3 0 1 0 21 5 A 9 3 0 1 0 3 5 M 3 5 V 19 A 9 3 0 0 0 21 19 V 5 M 3 12 A 9 3 0 0 0 21 12"
                                  Stroke="{DynamicResource TealBrush}" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top"
                                  Margin="0,2,12,0" />
                            <StackPanel>
                                <TextBlock Text="Service over REST and workspace browsing" FontWeight="SemiBold" />
                                <TextBlock Text="Need an Entra app client ID. REST is limited to 100,000 rows per query." Style="{StaticResource Muted}"
                                           FontSize="13" Margin="0,2,0,6" />
                                <Border Style="{StaticResource SuccessBadge}" Visibility="{Binding ClientIdConfigured, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Client ID set" />
                                </Border>
                                <Border Style="{StaticResource AccentBadge}" Visibility="{Binding ClientIdConfigured, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="Client ID not set (Settings)" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Message}" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19"
                                       Text="Both models are queried as you. Row-level security, roles and Desktop admin access can make data differ, so results are labelled 'as observed by current caller'." />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- How it works -->
            <Border Style="{StaticResource Card}" Padding="0">
                <UniformGrid Columns="4">
                    <DockPanel Margin="20,18">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <StackPanel>
                            <TextBlock Text="Connect" FontWeight="SemiBold" />
                            <TextBlock Text="Model A and model B" Style="{StaticResource Muted}" FontSize="13" />
                        </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0">
                        <DockPanel Margin="20,18">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Choose fields" FontWeight="SemiBold" />
                                <TextBlock Text="Keys, aggregations, synonyms" Style="{StaticResource Muted}" FontSize="13" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0">
                        <DockPanel Margin="20,18">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel>
                                <TextBlock Text="Set rules" FontWeight="SemiBold" />
                                <TextBlock Text="Filters and tolerances" Style="{StaticResource Muted}" FontSize="13" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0">
                        <DockPanel Margin="20,18">
                            <Border Style="{StaticResource StepNumber}" Background="{DynamicResource AccentFillBrush}" TextElement.Foreground="{DynamicResource OnAccentBrush}">
                                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Run and review" FontWeight="SemiBold" />
                                <TextBlock Text="Inspect and export to Excel" Style="{StaticResource Muted}" FontSize="13" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
