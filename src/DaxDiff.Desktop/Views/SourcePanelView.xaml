<UserControl x:Class="DaxDiff.Desktop.Views.SourcePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A in teal, B in cyan, as everywhere in the app. -->
        <Style x:Key="SideChip" TargetType="Border" BasedOn="{StaticResource SideChipA}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Side}" Value="B">
                    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TileTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="Text" Value="Not connected" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Text" Value="Connected" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Text" Value="Connection failed" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working"><Setter Property="Text" Value="Connecting…" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,20">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" AutomationProperties.LiveSetting="Polite">
                        <TextBlock Style="{StaticResource StateText}" />
                    </Border>
                    <Border Style="{StaticResource SideChip}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Side}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{DynamicResource TealBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Identity}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,14"
                           AutomationProperties.Name="Source identity" />

                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch">
                    <UniformGrid Columns="3" AutomationProperties.Name="Source type">
                        <RadioButton Style="{StaticResource Segment}" Content="_Desktop file" IsChecked="{Binding IsDesktop}"
                                     ToolTip="A PBIX that is open in Power BI Desktop" />
                        <RadioButton Style="{StaticResource Segment}" Content="Service · _XMLA" IsChecked="{Binding IsXmla}"
                                     ToolTip="A Power BI Service model through the XMLA endpoint (preferred)" />
                        <RadioButton Style="{StaticResource Segment}" Content="Service · _REST" IsChecked="{Binding IsRest}"
                                     ToolTip="A Power BI Service model through the Execute Queries REST API (fallback, row limits)" />
                    </UniformGrid>
                </Border>

                <!-- Desktop -->
                <StackPanel Visibility="{Binding IsDesktop, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="PBIX file (optional, helps pick the right session)" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowsePbixCommand}" Margin="8,0,0,8" />
                        <TextBox Text="{Binding PbixPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PBIX path" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Content="Open in Power BI Desktop" Command="{Binding OpenPbixInDesktopCommand}" />
                        <Button Content="↻ Detect _sessions" Command="{Binding DetectSessionsCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Running in Power BI Desktop" Style="{StaticResource SectionTitle}" Margin="0,4,0,6" />
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Height="124"
                             AutomationProperties.Name="Running Power BI Desktop sessions">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Server, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PbixPath, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding WindowTitle, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Service -->
                <StackPanel Visibility="{Binding IsService, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Message}" Margin="0,2,0,6">
                        <TextBlock Text="{Binding ServiceHint}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
                    </Border>
                    <Label Content="_Tenant (domain or tenant ID; 'organizations' = your own tenant)" Target="{Binding ElementName=Tenant}" />
                    <TextBox x:Name="Tenant" Text="{Binding Tenant, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Tenant"
                             ToolTip="For a model in another organisation's tenant, enter that tenant's domain (e.g. contoso.com) or tenant ID" />
                    <Label Content="_Account (user@domain; leave empty to use your Windows account)" Target="{Binding ElementName=Account}" />
                    <TextBox x:Name="Account" Text="{Binding AccountHint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Account" Tag="name@company.com"
                             ToolTip="The account that has access to the workspace. XMLA signs in as this account." />
                    <WrapPanel>
                        <Button Content="Sign _in…" Command="{Binding SignInCommand}" Style="{StaticResource SecondaryButton}"
                                ToolTip="Sign in to this tenant; you can pick a different account for each model" />
                        <Button Content="Sign out" Command="{Binding SignOutCommand}" />
                        <TextBlock Text="{Binding SignInStatusText}" VerticalAlignment="Center" Margin="4,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedText}" AutomationProperties.LiveSetting="Polite" />
                    </WrapPanel>

                    <StackPanel Visibility="{Binding CanBrowseService, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefreshWorkspacesCommand}" Margin="8,6,0,4"
                                    AutomationProperties.Name="Refresh workspaces" ToolTip="Reload the workspace list" />
                            <TextBlock Text="Workspace" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBox Text="{Binding WorkspaceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search workspaces" Tag="Search workspaces"
                                 ToolTip="Type to filter workspaces" />
                        <ComboBox ItemsSource="{Binding WorkspacesView}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Workspace" />
                        <TextBlock Text="Semantic model" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding DatasetSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search semantic models" Tag="Search semantic models"
                                 ToolTip="Type to filter semantic models" />
                        <ComboBox ItemsSource="{Binding DatasetsView}" SelectedItem="{Binding SelectedDataset}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Semantic model" />
                    </StackPanel>
                    <Label Content="_Workspace name or connection link (powerbi://…)" Target="{Binding ElementName=Workspace}" />
                    <TextBox x:Name="Workspace" Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name"
                             Tag="powerbi://api.powerbi.com/v1.0/myorg/Workspace name"
                             ToolTip="Paste the link from Workspace settings → License info → Connection link, or type the workspace name" />
                    <Label Content="Semantic _model name" Target="{Binding ElementName=Dataset}" />
                    <TextBox x:Name="Dataset" Text="{Binding DatasetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Semantic model name" />
                </StackPanel>

                <WrapPanel Margin="0,12,0,0">
                    <Button Content="_Test connection" Command="{Binding TestConnectionCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Refresh _metadata" Command="{Binding RefreshMetadataCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,2,0,4" LineHeight="20" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Connection status" />
                <TextBlock Text="{Binding MetadataSummary}" Style="{StaticResource Muted}" FontSize="13" />

                <Border Style="{StaticResource QuietPanel}" Margin="0,14,0,0" Visibility="{Binding Capabilities, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Capabilities.TransportName}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20">
                            <Run Text="Query: " Foreground="{DynamicResource MutedText}" /><Run Text="{Binding Capabilities.CanQuery, Mode=OneWay}" />
                            <Run Text="   Metadata: " Foreground="{DynamicResource MutedText}" /><Run Text="{Binding Capabilities.Metadata, Mode=OneWay}" />
                            <Run Text="   Row limit: " Foreground="{DynamicResource MutedText}" /><Run Text="{Binding Capabilities.MaxRowsPerQuery, Mode=OneWay, TargetNullValue=none}" />
                            <LineBreak /><Run Text="Identity: " Foreground="{DynamicResource MutedText}" /><Run Text="{Binding SecurityContext, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Capabilities.Notes}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Muted}" FontSize="12.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Metadata.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource WarningBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
