<UserControl x:Class="DaxDiff.Desktop.Views.SourcePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <Ellipse DockPanel.Dock="Right" Width="12" Height="12" Fill="{Binding State, Converter={StaticResource StateBrush}}"
                             ToolTip="{Binding State}" />
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding Identity}" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,8"
                           AutomationProperties.Name="Source identity" />

                <TextBlock Text="Source type" Style="{StaticResource SectionTitle}" />
                <WrapPanel>
                    <RadioButton Content="Power BI _Desktop (PBIX)" IsChecked="{Binding IsDesktop}" />
                    <RadioButton Content="Service – _XMLA" IsChecked="{Binding IsXmla}" />
                    <RadioButton Content="Service – _REST (fallback)" IsChecked="{Binding IsRest}" />
                </WrapPanel>

                <!-- Desktop -->
                <StackPanel Visibility="{Binding IsDesktop, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="PBIX file (optional, helps pick the right session)" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowsePbixCommand}" Margin="6,0,0,6" />
                        <TextBox Text="{Binding PbixPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PBIX path" />
                    </DockPanel>
                    <WrapPanel>
                        <Button Content="Open in Power BI Desktop" Command="{Binding OpenPbixInDesktopCommand}" />
                        <Button Content="Detect _sessions" Command="{Binding DetectSessionsCommand}" />
                    </WrapPanel>
                    <TextBlock Text="Running Power BI Desktop models" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Height="110"
                             AutomationProperties.Name="Running Power BI Desktop sessions">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Server, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding PbixPath, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding WindowTitle, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Service -->
                <StackPanel Visibility="{Binding IsService, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ServiceHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,6,0,6" />
                    <StackPanel Visibility="{Binding CanBrowseService, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <Button Content="Sign _in and browse" Command="{Binding SignInCommand}" />
                            <TextBlock Text="{Binding SignedInAs}" VerticalAlignment="Center" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="Workspace" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding WorkspaceSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search workspaces"
                                 ToolTip="Type to filter workspaces" />
                        <ComboBox ItemsSource="{Binding WorkspacesView}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Workspace" />
                        <TextBlock Text="Semantic model" Style="{StaticResource SectionTitle}" />
                        <TextBox Text="{Binding DatasetSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search semantic models"
                                 ToolTip="Type to filter semantic models" />
                        <ComboBox ItemsSource="{Binding DatasetsView}" SelectedItem="{Binding SelectedDataset}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="Semantic model" />
                    </StackPanel>
                    <TextBlock Text="Workspace name (XMLA)" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workspace name" />
                    <TextBlock Text="Semantic model name" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding DatasetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Semantic model name" />
                </StackPanel>

                <WrapPanel Margin="0,10,0,0">
                    <Button Content="_Test connection" Command="{Binding TestConnectionCommand}" FontWeight="SemiBold" />
                    <Button Content="Refresh _metadata" Command="{Binding RefreshMetadataCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,4,0,4" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Connection status" />
                <TextBlock Text="{Binding MetadataSummary}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />

                <StackPanel Visibility="{Binding Capabilities, Converter={StaticResource NullToVisibility}}" Margin="0,8,0,0">
                    <TextBlock Text="Connector capabilities" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Capabilities.TransportName, Mode=OneWay}" FontWeight="SemiBold" />
                        <LineBreak /><Run Text="Query: " /><Run Text="{Binding Capabilities.CanQuery, Mode=OneWay}" />
                        <Run Text="   Metadata: " /><Run Text="{Binding Capabilities.Metadata, Mode=OneWay}" />
                        <Run Text="   Row limit: " /><Run Text="{Binding Capabilities.MaxRowsPerQuery, Mode=OneWay, TargetNullValue=none}" />
                        <LineBreak /><Run Text="Identity: " /><Run Text="{Binding SecurityContext, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Capabilities.Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Metadata.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="DarkGoldenrod" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
