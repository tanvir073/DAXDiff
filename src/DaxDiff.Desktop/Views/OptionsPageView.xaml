<UserControl x:Class="DaxDiff.Desktop.Views.OptionsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DaxDiff.Desktop.Resources">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{x:Static res:Ui.OptPage_Step}" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{x:Static res:Ui.OptPage_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageHint}"
                       Text="{x:Static res:Ui.OptPage_Hint}" />
            <Border Style="{StaticResource Card}" Padding="20,14,20,6" Margin="0,0,0,14">
                <WrapPanel>
                    <Label Content="{x:Static res:Ui.OptPage_Picker}" Target="{Binding ElementName=Picker}" VerticalAlignment="Center" Padding="0,0,8,8" />
                    <ComboBox x:Name="Picker" Width="260" ItemsSource="{Binding Comparisons.Comparisons}" SelectedItem="{Binding Comparisons.Selected}"
                              DisplayMemberPath="DisplayName" Margin="0,0,16,8" />
                    <Button Content="{x:Static res:Ui.Cmp_Save}" Command="{Binding Comparisons.Selected.SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="{x:Static res:Ui.Cmp_Discard}" Command="{Binding Comparisons.Selected.DiscardChangesCommand}" />
                    <TextBlock Text="{Binding Comparisons.Selected.SaveStateText}" VerticalAlignment="Center" Margin="6,0,0,8" Foreground="{DynamicResource MutedText}" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <TextBlock Text="{x:Static res:Ui.OptPage_NoComparison}" Style="{StaticResource PageHint}"
                   Visibility="{Binding Comparisons.HasSelection, Converter={StaticResource InverseBoolToVisibility}}" DockPanel.Dock="Top" />
        <ContentControl Content="{Binding Comparisons.Selected.Options}" Focusable="False" />
    </DockPanel>
</UserControl>
