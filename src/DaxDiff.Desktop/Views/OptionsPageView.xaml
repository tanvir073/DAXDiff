<UserControl x:Class="DaxDiff.Desktop.Views.OptionsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="STEP 3 OF 5" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="Options" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageHint}"
                       Text="Each comparison has its own options. Every rule is explicit: nothing is normalized, rounded or treated as equal unless you choose it here. Numbers use '.' as decimal separator." />
            <Border Style="{StaticResource Card}" Padding="20,14,20,6" Margin="0,0,0,14">
                <WrapPanel>
                    <Label Content="Options for _comparison" Target="{Binding ElementName=Picker}" VerticalAlignment="Center" Padding="0,0,8,8" />
                    <ComboBox x:Name="Picker" Width="260" ItemsSource="{Binding Comparisons.Comparisons}" SelectedItem="{Binding Comparisons.Selected}"
                              DisplayMemberPath="DisplayName" Margin="0,0,16,8" />
                    <Button Content="_Save comparison" Command="{Binding Comparisons.Selected.SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Discard changes" Command="{Binding Comparisons.Selected.DiscardChangesCommand}" />
                    <TextBlock Text="{Binding Comparisons.Selected.SaveStateText}" VerticalAlignment="Center" Margin="6,0,0,8" Foreground="{DynamicResource MutedText}" />
                </WrapPanel>
            </Border>
        </StackPanel>
        <TextBlock Text="Create a comparison on the Comparisons page first." Style="{StaticResource PageHint}"
                   Visibility="{Binding Comparisons.HasSelection, Converter={StaticResource InverseBoolToVisibility}}" DockPanel.Dock="Top" />
        <ContentControl Content="{Binding Comparisons.Selected.Options}" Focusable="False" />
    </DockPanel>
</UserControl>
