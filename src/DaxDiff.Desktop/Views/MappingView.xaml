<UserControl x:Class="DaxDiff.Desktop.Views.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DaxDiff.Desktop.ViewModels">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:TableNode}" ItemsSource="{Binding Fields}">
            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:FieldNode}">
            <TextBlock Text="{Binding Display}" AutomationProperties.Name="{Binding AccessibleName}" />
        </DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Field mapping" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageHint}"
                       Text="Pair one or more key columns (the comparison grain) and the measures to compare. Names may differ between models. Suggested pairs must be accepted before they run." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding HeaderA, StringFormat='Model A — {0}'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBox DockPanel.Dock="Top" Text="{Binding SearchA, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"
                         AutomationProperties.Name="Search model A fields" ToolTip="Search model A tables and fields" />
                <TreeView x:Name="TreeA" ItemsSource="{Binding TreeA}" SelectedItemChanged="TreeA_SelectedItemChanged"
                          AutomationProperties.Name="Model A fields" VirtualizingPanel.IsVirtualizing="True" />
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding HeaderB, StringFormat='Model B — {0}'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBox DockPanel.Dock="Top" Text="{Binding SearchB, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"
                         AutomationProperties.Name="Search model B fields" ToolTip="Search model B tables and fields" />
                <TreeView x:Name="TreeB" ItemsSource="{Binding TreeB}" SelectedItemChanged="TreeB_SelectedItemChanged"
                          AutomationProperties.Name="Model B fields" VirtualizingPanel.IsVirtualizing="True" />
            </DockPanel>
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,8,0,4">
            <Button Content="_Add pair" Command="{Binding AddPairCommand}" FontWeight="SemiBold"
                    ToolTip="Pair the selected A field with the selected B field" />
            <Button Content="Suggest for _selected" Command="{Binding SuggestForSelectedCommand}" />
            <Button Content="Suggest all _measures" Command="{Binding SuggestMeasuresCommand}" />
            <Button Content="A_ccept" Command="{Binding AcceptPairCommand}" />
            <Button Content="Accept a_ll" Command="{Binding AcceptAllCommand}" />
            <Button Content="_Remove" Command="{Binding RemovePairCommand}" />
            <Button Content="Replace A field" Command="{Binding ReplaceLeftCommand}" ToolTip="Repair: use the field selected in the A tree" />
            <Button Content="Replace B field" Command="{Binding ReplaceRightCommand}" ToolTip="Repair: use the field selected in the B tree" />
            <Button Content="▲" MinWidth="32" Command="{Binding MoveUpCommand}" AutomationProperties.Name="Move pair up" ToolTip="Move up (key order)" />
            <Button Content="▼" MinWidth="32" Command="{Binding MoveDownCommand}" AutomationProperties.Name="Move pair down" ToolTip="Move down (key order)" />
            <Button Content="Clear" Command="{Binding ClearPairsCommand}" />
            <CheckBox Content="Show _hidden fields" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center" />
        </WrapPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                  AutomationProperties.Name="Field pairs">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfirmed}" Value="False">
                            <Setter Property="Background" Value="#FFF4CE" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Role" Binding="{Binding RoleText}" IsReadOnly="True" />
                <DataGridTextColumn Header="Label (editable)" Binding="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <DataGridTextColumn Header="Model A field" Binding="{Binding LeftText}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Model B field" Binding="{Binding RightText}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="State" Binding="{Binding ConfirmText}" IsReadOnly="True" />
                <DataGridTextColumn Header="Problem" Binding="{Binding Issue}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Suggestion" Binding="{Binding Note}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <ItemsControl Grid.Row="4" ItemsSource="{Binding Issues}" Margin="0,8,0,0" MaxHeight="110"
                      AutomationProperties.Name="Validation messages">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="DarkGoldenrod" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
