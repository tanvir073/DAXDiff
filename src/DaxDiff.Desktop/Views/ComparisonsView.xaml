<UserControl x:Class="DaxDiff.Desktop.Views.ComparisonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DaxDiff.Desktop.Resources"
             xmlns:vm="clr-namespace:DaxDiff.Desktop.ViewModels"
             xmlns:v="clr-namespace:DaxDiff.Desktop.Views"
             x:Name="Root">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:TableNode}" ItemsSource="{Binding Fields}">
            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Margin="0,2" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:FieldNode}">
            <TextBlock Text="{Binding Display}" AutomationProperties.Name="{Binding AccessibleName}" Margin="0,1" />
        </DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
            <EventSetter Event="Loaded" Handler="TreeItem_Loaded" />
            <!-- Items selected with Ctrl+click or Shift+click (TreeMultiSelect); a single selection uses the tree's own highlight. -->
            <Style.Triggers>
                <!-- Fields already in the comparison (and tables whose fields all are) are not offered again. -->
                <DataTrigger Binding="{Binding IsInComparison}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="v:TreeMultiSelect.IsMultiSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MintBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The Field and Type headers hold a search box under the title; every title sits at the top to line up. -->
        <Style x:Key="FieldGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="10,7,6,6" />
        </Style>
        <!-- Field grid for one side; DataContext = that side's FieldsA / FieldsB collection. -->
        <Style x:Key="FieldGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="ColumnHeaderHeight" Value="66" />
        </Style>
        <!-- Amber: warning (for example not compared). Red: error that blocks the run. -->
        <Style x:Key="ProblemRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Issue, Converter={StaticResource NullToVisibility}}" Value="Visible">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,2,26,2" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="HeaderSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <EventSetter Event="KeyDown" Handler="HeaderSearch_KeyDown" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- Enum values (aggregations) in the UI language. -->
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Static res:Ui.Cmp_Step}" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{x:Static res:Ui.Cmp_Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />
        </StackPanel>

        <!-- Comparison picker and save bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,12,18,4" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <Label Content="{x:Static res:Ui.Cmp_PickerLabel}" Target="{Binding ElementName=ComparisonPicker}" VerticalAlignment="Center" Padding="0,0,8,8" />
                    <ComboBox x:Name="ComparisonPicker" Width="240" ItemsSource="{Binding Comparisons}" SelectedItem="{Binding Selected}"
                              DisplayMemberPath="DisplayName" Margin="0,0,16,8" ToolTip="{x:Static res:Ui.Cmp_PickerTip}" />
                    <Label Content="{x:Static res:Ui.Cmp_NameLabel}" Target="{Binding ElementName=ComparisonName}" VerticalAlignment="Center" Padding="0,0,8,8" />
                    <TextBox x:Name="ComparisonName" Width="210" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasSelection}" Margin="0,0,16,8" />
                    <Button Content="{x:Static res:Ui.Cmp_New}" Command="{Binding NewComparisonCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="{x:Static res:Ui.Cmp_Duplicate}" Command="{Binding DuplicateComparisonCommand}" />
                    <Button Content="{x:Static res:Ui.Cmp_Delete}" Command="{Binding DeleteComparisonCommand}" />
                </WrapPanel>
                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.StatusText}" VerticalAlignment="Center" Margin="12,0,0,8"
                               AutomationProperties.LiveSetting="Polite" FontWeight="SemiBold" Foreground="{DynamicResource TealBrush}" />
                    <WrapPanel>
                        <Button Command="{Binding Selected.SaveCommand}" Style="{StaticResource PrimaryButton}"
                                ToolTip="{x:Static res:Ui.Cmp_SaveTip}" Content="{x:Static res:Ui.Cmp_Save}" />
                        <Button Content="{x:Static res:Ui.Cmp_Discard}" Command="{Binding Selected.DiscardChangesCommand}" ToolTip="{x:Static res:Ui.Cmp_DiscardTip}" />
                        <Button Command="{Binding Selected.Options.EditFiltersCommand}" ToolTip="{x:Static res:Ui.Cmp_FiltersTip}">
                            <TextBlock>
                                <Run Text="{x:Static res:Ui.Cmp_FiltersOpen}" /><Run Text="{Binding Selected.Options.Filters.Count, Mode=OneWay}" /><Run Text=")…" />
                            </TextBlock>
                        </Button>
                        <!-- Applies to both model trees, so it sits above them. -->
                        <CheckBox Content="{x:Static res:Ui.Cmp_ShowHidden}" IsChecked="{Binding ShowHidden}" VerticalAlignment="Center"
                                  Margin="8,0,16,8" ToolTip="{x:Static res:Ui.Cmp_ShowHiddenTip}" />
                        <TextBlock Text="{Binding Selected.SaveStateText}" VerticalAlignment="Center" Margin="6,0,0,8" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.IsModified}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{x:Static res:Ui.Cmp_EmptyTitle}" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{x:Static res:Ui.Cmp_EmptyText}" Style="{StaticResource Muted}"
                           Margin="0,0,0,14" />
                <Button Content="{x:Static res:Ui.Cmp_New}" Command="{Binding NewComparisonCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="260" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Model A -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource SideChipA}" Margin="0,0,10,0" Padding="10,4" ToolTip="{Binding HeaderA}"
                                AutomationProperties.Name="{Binding HeaderA}"><TextBlock Text="A" FontSize="13" /></Border>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Ui.Cmp_InsertA}" Command="{Binding InsertACommand}" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" ToolTip="{x:Static res:Ui.Cmp_InsertTip}" />
                        <TextBox Text="{Binding SearchA, UpdateSourceTrigger=PropertyChanged}" Margin="0" Tag="{x:Static res:Ui.Cmp_SearchA}"
                                 AutomationProperties.Name="{x:Static res:Ui.Cmp_SearchA}" ToolTip="{x:Static res:Ui.Cmp_SearchA}" />
                    </DockPanel>
                    <TreeView Grid.Row="1" x:Name="TreeA" ItemsSource="{Binding TreeA}" SelectedItemChanged="TreeA_SelectedItemChanged"
                              MouseDoubleClick="TreeA_MouseDoubleClick" KeyDown="TreeA_KeyDown"
                              AutomationProperties.Name="{x:Static res:Ui.Cmp_TreeA}" VirtualizingPanel.IsVirtualizing="True" />
                    <DataGrid Grid.Row="2" Margin="0,8,0,0" x:Name="FieldsA" ItemsSource="{Binding Selected.FieldsA}" Style="{StaticResource FieldGrid}"
                              RowStyle="{StaticResource ProblemRow}" AutomationProperties.Name="{x:Static res:Ui.Cmp_FieldsA}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_ColKey}" MinWidth="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBeKey}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                  AutomationProperties.Name="{x:Static res:Ui.Cmp_ColKey}" ToolTip="{x:Static res:Ui.Cmp_KeyTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn HeaderStyle="{StaticResource FieldGridHeader}" Binding="{Binding FieldText}" IsReadOnly="True" Width="*" MinWidth="110">
                                <DataGridTextColumn.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Ui.Cmp_ColField}" />
                                        <TextBox Text="{Binding DataContext.FieldSearchA, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged, Delay=150}" Style="{StaticResource HeaderSearch}"
                                                 Tag="{x:Static res:Ui.Cmp_SearchFieldPlaceholder}" ToolTip="{x:Static res:Ui.Cmp_SearchFieldTip}" AutomationProperties.Name="{x:Static res:Ui.Cmp_SearchFieldA}" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_ColType}" Binding="{Binding TypeText}" IsReadOnly="True" />
                            <DataGridTemplateColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_Aggregation}" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AllowedAggregations}" SelectedItem="{Binding Aggregation, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanAggregate}" Style="{StaticResource CellCombo}" AutomationProperties.Name="{x:Static res:Ui.Cmp_Aggregation}"
                                                  ItemTemplate="{StaticResource EnumItem}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_ColSynonym}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Synonym, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellText}"
                                                 AutomationProperties.Name="{x:Static res:Ui.Cmp_ColSynonym}" ToolTip="{Binding PairText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3">
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                   Text="{Binding SelectedItem.Issue, ElementName=FieldsA}" Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding SelectedItem.Issue, ElementName=FieldsA, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                   Text="{Binding SelectedItem.PairText, ElementName=FieldsA}" Foreground="{DynamicResource MutedText}"
                                   Visibility="{Binding SelectedItem.PairText, ElementName=FieldsA, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{x:Static res:Ui.Cmp_CopyToB}" Style="{StaticResource SmallButton}" Command="{Binding CopyToBCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FieldsA}"
                                    ToolTip="{x:Static res:Ui.Cmp_CopyToBTip}" />
                            <Button Content="{x:Static res:Ui.Cmp_Remove}" Style="{StaticResource SmallButton}" Command="{Binding RemoveFieldsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FieldsA}" />
                            <Button Content="▲" Style="{StaticResource SmallButton}" Command="{Binding MoveFieldUpCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=FieldsA}"
                                    AutomationProperties.Name="{x:Static res:Ui.Cmp_MoveUpA}" ToolTip="{x:Static res:Ui.Cmp_MoveUpKeyTip}" />
                            <Button Content="▼" Style="{StaticResource SmallButton}" Command="{Binding MoveFieldDownCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=FieldsA}"
                                    AutomationProperties.Name="{x:Static res:Ui.Cmp_MoveDownA}" ToolTip="{x:Static res:Ui.Cmp_MoveDownKeyTip}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Model B -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Border Style="{StaticResource SideChipB}" Margin="0,0,10,0" Padding="10,4" ToolTip="{Binding HeaderB}"
                                AutomationProperties.Name="{Binding HeaderB}"><TextBlock Text="B" FontSize="13" /></Border>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Ui.Cmp_InsertB}" Command="{Binding InsertBCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" ToolTip="{x:Static res:Ui.Cmp_InsertTip}" />
                        <TextBox Text="{Binding SearchB, UpdateSourceTrigger=PropertyChanged}" Margin="0" Tag="{x:Static res:Ui.Cmp_SearchB}"
                                 AutomationProperties.Name="{x:Static res:Ui.Cmp_SearchB}" ToolTip="{x:Static res:Ui.Cmp_SearchB}" />
                    </DockPanel>
                    <TreeView Grid.Row="1" x:Name="TreeB" ItemsSource="{Binding TreeB}" SelectedItemChanged="TreeB_SelectedItemChanged"
                              MouseDoubleClick="TreeB_MouseDoubleClick" KeyDown="TreeB_KeyDown"
                              AutomationProperties.Name="{x:Static res:Ui.Cmp_TreeB}" VirtualizingPanel.IsVirtualizing="True" />
                    <DataGrid Grid.Row="2" Margin="0,8,0,0" x:Name="FieldsB" ItemsSource="{Binding Selected.FieldsB}" Style="{StaticResource FieldGrid}"
                              RowStyle="{StaticResource ProblemRow}" AutomationProperties.Name="{x:Static res:Ui.Cmp_FieldsB}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_ColKey}" MinWidth="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBeKey}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                  AutomationProperties.Name="{x:Static res:Ui.Cmp_ColKey}" ToolTip="{x:Static res:Ui.Cmp_KeyTip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn HeaderStyle="{StaticResource FieldGridHeader}" Binding="{Binding FieldText}" IsReadOnly="True" Width="*" MinWidth="110">
                                <DataGridTextColumn.Header>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Ui.Cmp_ColField}" />
                                        <TextBox Text="{Binding DataContext.FieldSearchB, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged, Delay=150}" Style="{StaticResource HeaderSearch}"
                                                 Tag="{x:Static res:Ui.Cmp_SearchFieldPlaceholder}" ToolTip="{x:Static res:Ui.Cmp_SearchFieldTip}" AutomationProperties.Name="{x:Static res:Ui.Cmp_SearchFieldB}" />
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_ColType}" Binding="{Binding TypeText}" IsReadOnly="True" />
                            <DataGridTemplateColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_Aggregation}" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AllowedAggregations}" SelectedItem="{Binding Aggregation, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanAggregate}" Style="{StaticResource CellCombo}" AutomationProperties.Name="{x:Static res:Ui.Cmp_Aggregation}"
                                                  ItemTemplate="{StaticResource EnumItem}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn HeaderStyle="{StaticResource FieldGridHeader}" Header="{x:Static res:Ui.Cmp_ColSynonym}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Synonym, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellText}"
                                                 AutomationProperties.Name="{x:Static res:Ui.Cmp_ColSynonym}" ToolTip="{Binding PairText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3">
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                   Text="{Binding SelectedItem.Issue, ElementName=FieldsB}" Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding SelectedItem.Issue, ElementName=FieldsB, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                   Text="{Binding SelectedItem.PairText, ElementName=FieldsB}" Foreground="{DynamicResource MutedText}"
                                   Visibility="{Binding SelectedItem.PairText, ElementName=FieldsB, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{x:Static res:Ui.Cmp_CopyToA}" Style="{StaticResource SmallButton}" Command="{Binding CopyToACommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FieldsB}"
                                    ToolTip="{x:Static res:Ui.Cmp_CopyToATip}" />
                            <Button Content="{x:Static res:Ui.Cmp_Remove}" Style="{StaticResource SmallButton}" Command="{Binding RemoveFieldsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FieldsB}" />
                            <Button Content="▲" Style="{StaticResource SmallButton}" Command="{Binding MoveFieldUpCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=FieldsB}"
                                    AutomationProperties.Name="{x:Static res:Ui.Cmp_MoveUpB}" ToolTip="{x:Static res:Ui.Cmp_MoveUpTip}" />
                            <Button Content="▼" Style="{StaticResource SmallButton}" Command="{Binding MoveFieldDownCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=FieldsB}"
                                    AutomationProperties.Name="{x:Static res:Ui.Cmp_MoveDownB}" ToolTip="{x:Static res:Ui.Cmp_MoveDownTip}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="12" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"
                          ToolTip="{x:Static res:Ui.Cmp_SplitterTip}" AutomationProperties.Name="{x:Static res:Ui.Cmp_Splitter}" />

            <!-- Pairing and validation -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16,14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{x:Static res:Ui.Cmp_MatchSynonyms}" Command="{Binding MatchSynonymsCommand}" Style="{StaticResource SmallButton}"
                                    ToolTip="{x:Static res:Ui.Cmp_MatchSynonymsTip}" />
                            <Button Content="{x:Static res:Ui.Cmp_FindB}" Command="{Binding AddMatchingFieldsCommand}" Style="{StaticResource SmallButton}" Margin="0"
                                    ToolTip="{x:Static res:Ui.Cmp_FindBTip}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,12,0"
                                   Text="{x:Static res:Ui.Cmp_PairingHint}" />
                    </DockPanel>
                    <TabControl>
                        <TabItem Header="{x:Static res:Ui.Cmp_PairsTab}">
                            <DataGrid ItemsSource="{Binding Selected.Pairs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      AutomationProperties.Name="{x:Static res:Ui.Cmp_PairsTab}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static res:Ui.Cmp_ColSynonym}" Binding="{Binding Synonym}" Width="160" />
                                    <DataGridTextColumn Header="{x:Static res:Ui.Cmp_ColRole}" Binding="{Binding Role}" Width="70" />
                                    <DataGridTextColumn Header="{x:Static res:Ui.Cmp_ColModelA}" Binding="{Binding A}" Width="*" />
                                    <DataGridTextColumn Header="{x:Static res:Ui.Cmp_ColModelB}" Binding="{Binding B}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{Binding Selected.Compiled.Issues.Count}" HeaderStringFormat="{x:Static res:Ui.Cmp_IssuesTab}">
                            <ListBox ItemsSource="{Binding Selected.Compiled.Issues}" AutomationProperties.Name="{x:Static res:Ui.Cmp_Issues}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
