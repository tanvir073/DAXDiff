<UserControl x:Class="DaxDiff.Desktop.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DaxDiff.Desktop.Resources;assembly=DaxDiff.Presentation"
             xmlns:local="clr-namespace:DaxDiff.Desktop"
             xmlns:vm="clr-namespace:DaxDiff.Desktop.ViewModels;assembly=DaxDiff.Presentation">
    <UserControl.Resources>
        <local:EnumEqualsConverter x:Key="EnumEquals" />
        <Style x:Key="FilterSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="ResultFilter" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel>
            <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="16,0,0,18"
                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Label Content="{x:Static res:Ui.Results_Picker}" Target="{Binding ElementName=ResultPicker}" Padding="0,0,8,8" VerticalAlignment="Center" />
                <ComboBox x:Name="ResultPicker" Width="300" Margin="0,0,12,8" ItemsSource="{Binding Results}" SelectedItem="{Binding Result}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ComparisonName, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource EnumText}}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{x:Static res:Ui.Results_Export}" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
            </WrapPanel>
            <StackPanel>
                <TextBlock Text="{x:Static res:Ui.Results_Step}" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{x:Static res:Ui.Results_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Static res:Ui.Results_None}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{x:Static res:Ui.Results_Observed}" Style="{StaticResource PageHint}"
                           Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <!-- Status, KPIs, run details -->
        <StackPanel Grid.Row="1" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Border Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SuccessMessage}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncomplete}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusBanner}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="{x:Static res:Ui.Results_RunStatus}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Kpis}" Focusable="False" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,6" Padding="14,10" CornerRadius="14">
                            <StackPanel AutomationProperties.Name="{Binding Key}">
                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource MutedText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Value" Text="{Binding Value}" Style="{StaticResource KpiValue}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="{x:Static res:Ui.Results_KpiMismatches}">
                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="{x:Static res:Ui.Results_KpiMatches}">
                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="{x:Static res:Ui.Results_KpiMatchRate}">
                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="{x:Static res:Ui.Results_KpiOnlyInA}">
                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="{x:Static res:Ui.Results_KpiOnlyInB}">
                                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Capped and scrolled: with many compared columns the details would otherwise push the grid off the page. -->
            <Expander Header="{x:Static res:Ui.Results_Details}" Margin="0,0,0,10">
                <Border Style="{StaticResource QuietPanel}" Margin="0,6,0,0">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBox Text="{Binding SourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Margin="0" Padding="0" Style="{x:Null}" FontSize="13" />
                        <ItemsControl ItemsSource="{Binding MeasureStats}" Margin="0,6,0,0" />
                        <ItemsControl ItemsSource="{Binding Result.Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Expander>
        </StackPanel>

        <!-- Rows -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Failed columns: Ctrl+click and Shift+click pick several; the grid then keeps those and the keys. -->
                            <Grid Width="240" Margin="0,0,12,6" Visibility="{Binding HasFailedColumns, Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton x:Name="ColumnPickerToggle" Template="{StaticResource ComboToggle}" MinHeight="36" BorderThickness="1"
                                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                                              IsChecked="{Binding IsOpen, ElementName=ColumnPickerPopup}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=ColumnPickerPopup, Converter={StaticResource InverseBool}}"
                                              AutomationProperties.Name="{x:Static res:Ui.Results_ColumnPicker}" ToolTip="{x:Static res:Ui.Results_ColumnPickerTip}" />
                                <TextBlock Text="{Binding ColumnPickerText}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}" />
                                <Popup x:Name="ColumnPickerPopup" PlacementTarget="{Binding ElementName=ColumnPickerToggle}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="ColumnPicker_Opened">
                                    <Border Margin="0,4,8,8" MinWidth="240" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrongBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="{StaticResource ShadowColor}" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Ui.Results_ColumnPickerHint}" Foreground="{DynamicResource MutedText}" FontSize="12.5"
                                                       TextWrapping="Wrap" MaxWidth="260" Margin="2,0,2,6" />
                                            <ListBox x:Name="ColumnPickerList" ItemsSource="{Binding FailedColumns}" SelectionMode="Extended" MaxHeight="300"
                                                     BorderThickness="0" Padding="0" SelectionChanged="ColumnPicker_SelectionChanged"
                                                     AutomationProperties.Name="{x:Static res:Ui.Results_ColumnPicker}" />
                                            <Button Content="{x:Static res:Ui.Results_ColumnsShowAll}" Click="ColumnPicker_ShowAll" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock Text="{Binding VisibleCountText}" VerticalAlignment="Center" Margin="0,0,12,6" Foreground="{DynamicResource MutedText}" FontSize="13" />
                            <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,0,6"
                                     AutomationProperties.Name="{x:Static res:Ui.Results_Search}" ToolTip="{x:Static res:Ui.Results_SearchTip}" Tag="{x:Static res:Ui.Results_SearchPlaceholder}" />
                        </StackPanel>
                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,12,6">
                            <WrapPanel AutomationProperties.Name="{x:Static res:Ui.Results_ShowRows}">
                                <RadioButton Style="{StaticResource FilterSegment}" Content="{x:Static res:Ui.Results_FilterAll}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ResultFilter.All}}" />
                                <RadioButton Style="{StaticResource FilterSegment}" Content="{x:Static res:Ui.Results_FilterMatch}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ResultFilter.Match}}" />
                                <RadioButton Style="{StaticResource FilterSegment}" Content="{x:Static res:Ui.Results_FilterMismatch}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ResultFilter.Mismatch}}" />
                                <RadioButton Style="{StaticResource FilterSegment}" Content="{x:Static res:Ui.Results_KpiOnlyInA}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ResultFilter.OnlyInA}}" />
                                <RadioButton Style="{StaticResource FilterSegment}" Content="{x:Static res:Ui.Results_KpiOnlyInB}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ResultFilter.OnlyInB}}" />
                                <RadioButton Style="{StaticResource FilterSegment}" Content="{x:Static res:Ui.Results_FilterInvalidKey}"
                                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ResultFilter.InvalidKey}}" />
                            </WrapPanel>
                        </Border>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:Ui.Results_ExportIncludes}" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13" />
                        <CheckBox Content="{x:Static res:Ui.Results_ExportAllData}" IsChecked="{Binding ExportAllData}" Margin="0,0,14,0" />
                        <CheckBox Content="{x:Static res:Ui.Results_ExportDax}" IsChecked="{Binding ExportQueryText}" Margin="0" />
                    </StackPanel>
                </Border>
                <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding RowsView.ItemsSource}" SelectedItem="{Binding SelectedRow}" BorderThickness="0"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          SelectionMode="Extended" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Sorting="Grid_Sorting" SelectedCellsChanged="Grid_SelectedCellsChanged"
                          AutomationProperties.Name="{x:Static res:Ui.Results_Grid}" />
            </DockPanel>
        </Border>

        <Expander Grid.Row="3" Header="{x:Static res:Ui.Results_RowDetails}" IsExpanded="True" Margin="0,10,0,0"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBox Text="{Binding Details, Mode=OneWay}" Style="{StaticResource CodeBox}" MaxHeight="150" Margin="0,6,0,0"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="{x:Static res:Ui.Results_RowDetails}" />
        </Expander>
    </Grid>
</UserControl>
