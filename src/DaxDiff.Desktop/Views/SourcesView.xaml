<UserControl x:Class="DaxDiff.Desktop.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DaxDiff.Desktop.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Sources" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageHint}"
                       Text="Choose model A and model B independently: any pairing of local Power BI Desktop and Power BI Service is supported. Test each connection to load its metadata." />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SourcePanelView Grid.Column="0" DataContext="{Binding SourceA}" />
            <Button Grid.Column="1" Content="⇄ S_wap" Command="{Binding SwapCommand}" VerticalAlignment="Top" Margin="12,40,12,0"
                    MinWidth="0" ToolTip="Swap model A and model B, including mappings and filters"
                    AutomationProperties.Name="Swap sides" />
            <views:SourcePanelView Grid.Column="2" DataContext="{Binding SourceB}" />
        </Grid>
    </DockPanel>
</UserControl>
