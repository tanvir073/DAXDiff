<UserControl x:Class="DaxDiff.Desktop.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DaxDiff.Desktop.Resources;assembly=DaxDiff.Presentation"
             xmlns:views="clr-namespace:DaxDiff.Desktop.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"
                    Margin="16,0,0,18" Content="{x:Static res:Ui.Sources_Next}" />
            <StackPanel>
                <TextBlock Text="{x:Static res:Ui.Sources_Step}" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{x:Static res:Ui.Sources_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageHint}"
                           Text="{x:Static res:Ui.Sources_Hint}" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SourcePanelView Grid.Column="0" DataContext="{Binding SourceA}" />
            <Button Grid.Column="1" Style="{StaticResource RoundButton}" Command="{Binding SwapCommand}" VerticalAlignment="Top" Margin="12,24,12,0"
                    ToolTip="{x:Static res:Ui.Sources_SwapTip}" AutomationProperties.Name="{x:Static res:Ui.Sources_Swap}">
                <Path Data="M 12 0 L 16 4 L 12 8 M 16 4 H 0 M 4 10 L 0 14 L 4 18 M 0 14 H 16" Stroke="{DynamicResource TealBrush}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" />
            </Button>
            <views:SourcePanelView Grid.Column="2" DataContext="{Binding SourceB}" />
        </Grid>
    </DockPanel>
</UserControl>
