<UserControl x:Class="DaxDiff.Desktop.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DaxDiff.Desktop.Resources;assembly=DaxDiff.Presentation"
             xmlns:vm="clr-namespace:DaxDiff.Desktop.ViewModels;assembly=DaxDiff.Presentation">
    <UserControl.Resources>
        <!-- Enum values (option choices) in the UI language. -->
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Ui.Opt_ValueTitle}" Style="{StaticResource CardTitle}" />
                        <Label Content="{x:Static res:Ui.Opt_Mode}" Target="{Binding ElementName=ToleranceMode}" Padding="0,0,0,2" />
                        <ComboBox x:Name="ToleranceMode" ItemsSource="{x:Static vm:OptionsViewModel.ToleranceModes}" SelectedItem="{Binding ToleranceMode}" ItemTemplate="{StaticResource EnumItem}" />
                        <Label Content="{x:Static res:Ui.Opt_AbsTol}" Target="{Binding ElementName=AbsTol}" Padding="0,0,0,2" />
                        <TextBox x:Name="AbsTol" Text="{Binding AbsoluteTolerance, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="{x:Static res:Ui.Opt_RelTol}" Target="{Binding ElementName=RelTol}" Padding="0,0,0,2" />
                        <TextBox x:Name="RelTol" Text="{Binding RelativeTolerance, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{x:Static res:Ui.Opt_TolFormula}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,8" />
                        <Label Content="{x:Static res:Ui.Opt_NullPolicy}" Target="{Binding ElementName=NullPolicy}" Padding="0,0,0,2" />
                        <ComboBox x:Name="NullPolicy" ItemsSource="{x:Static vm:OptionsViewModel.NullPolicies}" SelectedItem="{Binding NullPolicy}" ItemTemplate="{StaticResource EnumItem}" />
                        <Label Content="{x:Static res:Ui.Opt_TextCmp}" Target="{Binding ElementName=TextCmp}" Padding="0,0,0,2" />
                        <ComboBox x:Name="TextCmp" ItemsSource="{x:Static vm:OptionsViewModel.TextComparisons}" SelectedItem="{Binding TextComparison}" ItemTemplate="{StaticResource EnumItem}" />
                        <Label Content="{x:Static res:Ui.Opt_Baseline}" Target="{Binding ElementName=Baseline}" Padding="0,0,0,2" />
                        <ComboBox x:Name="Baseline" ItemsSource="{x:Static vm:OptionsViewModel.PercentBaselines}" SelectedItem="{Binding PercentBaseline}" ItemTemplate="{StaticResource EnumItem}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Ui.Opt_KeyTitle}" Style="{StaticResource CardTitle}" />
                        <CheckBox Content="{x:Static res:Ui.Opt_Trim}" IsChecked="{Binding TrimWhitespace}" />
                        <CheckBox Content="{x:Static res:Ui.Opt_CaseInsensitive}" IsChecked="{Binding CaseInsensitiveKeys}" />
                        <CheckBox Content="{x:Static res:Ui.Opt_BlankEqualsEmpty}" IsChecked="{Binding BlankEqualsEmpty}" />
                        <CheckBox Content="{x:Static res:Ui.Opt_DateOnly}" IsChecked="{Binding DateOnly}" />
                        <Label Content="{x:Static res:Ui.Opt_Unicode}" Target="{Binding ElementName=Unicode}" Padding="0,0,0,2" />
                        <ComboBox x:Name="Unicode" ItemsSource="{x:Static vm:OptionsViewModel.UnicodeForms}" SelectedItem="{Binding Unicode}" ItemTemplate="{StaticResource EnumItem}" />
                        <Label Content="{x:Static res:Ui.Opt_Dupes}" Target="{Binding ElementName=Dupes}" Padding="0,0,0,2" />
                        <ComboBox x:Name="Dupes" ItemsSource="{x:Static vm:OptionsViewModel.DuplicatePolicies}" SelectedItem="{Binding DuplicateKeyPolicy}" ItemTemplate="{StaticResource EnumItem}" />

                        <TextBlock Text="{x:Static res:Ui.Opt_LimitsTitle}" Style="{StaticResource CardTitle}" Margin="0,14,0,8" />
                        <Label Content="{x:Static res:Ui.Opt_MaxRows}" Target="{Binding ElementName=MaxRows}" Padding="0,0,0,2" />
                        <TextBox x:Name="MaxRows" Text="{Binding MaxRows, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="{x:Static res:Ui.Opt_Timeout}" Target="{Binding ElementName=Timeout}" Padding="0,0,0,2" />
                        <TextBox x:Name="Timeout" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="{x:Static res:Ui.Opt_Retries}" Target="{Binding ElementName=Retries}" Padding="0,0,0,2" />
                        <TextBox x:Name="Retries" Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="{x:Static res:Ui.Opt_ResultTitle}" Style="{StaticResource CardTitle}" Margin="0,14,0,8" />
                        <RadioButton Content="{x:Static res:Ui.Opt_ShowAll}" GroupName="ResultRows" IsChecked="{Binding DifferencesOnly, Converter={StaticResource InverseBool}}" />
                        <RadioButton Content="{x:Static res:Ui.Opt_ShowDiffs}" GroupName="ResultRows" IsChecked="{Binding DifferencesOnly}" />
                        <CheckBox Content="{x:Static res:Ui.Opt_LimitRows}" IsChecked="{Binding LimitResultRows}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding MaxResultRows, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding LimitResultRows}"
                                 AutomationProperties.Name="{x:Static res:Ui.Opt_MaxResultRows}" />
                        <TextBlock Text="{x:Static res:Ui.Opt_ResultHint}"
                                   Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Opt_FiltersTitle}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding FiltersSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{x:Static res:Ui.Opt_EditFilters}" Command="{Binding EditFiltersCommand}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                            ToolTip="{x:Static res:Ui.Opt_EditFiltersTip}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Ui.Opt_PreviewTitle}" Style="{StaticResource CardTitle}" />
                    <WrapPanel>
                        <Button Content="{x:Static res:Ui.Opt_PreviewDax}" Command="{Binding PreviewQueriesCommand}" />
                        <Button Content="{x:Static res:Ui.Opt_EstimateRows}" Command="{Binding EstimateRowsCommand}" />
                        <TextBlock Text="{Binding EstimateText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QueryPreviewA, Mode=OneWay}" Style="{StaticResource CodeBox}" MinHeight="150"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static res:Ui.Opt_QueryA}" />
                        <TextBox Grid.Column="2" Text="{Binding QueryPreviewB, Mode=OneWay}" Style="{StaticResource CodeBox}" MinHeight="150"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static res:Ui.Opt_QueryB}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
