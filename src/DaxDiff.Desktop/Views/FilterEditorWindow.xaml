<Window x:Class="DaxDiff.Desktop.Views.FilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="980" Height="660" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SubtleBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="16">
        <!-- Apply / Cancel -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="_Apply" IsDefault="True" Click="Apply_Click" FontWeight="SemiBold" Margin="0,0,6,0" MinWidth="90" />
                <Button Content="Cancel" IsCancel="True" Margin="0" MinWidth="90" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Each filter is applied to both models: the model A column and its model B counterpart get the same rule. Apply, then save the comparison to use the filters in runs." />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter list -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Filters on this comparison" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="_Add filter" Command="{Binding AddFilterCommand}" FontWeight="SemiBold" />
                    <Button Content="_Remove" Command="{Binding RemoveFilterCommand}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                           Text="Connect both models on the Sources page to pick columns and load values."
                           Visibility="{Binding ModelsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Filters"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                                    <Run Text="A: " /><Run Text="{Binding LeftColumn, Mode=OneWay, TargetNullValue='–'}" />
                                    <Run Text="   B: " /><Run Text="{Binding RightColumn, Mode=OneWay, TargetNullValue='–'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Issues}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding Issues, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Selected filter -->
            <TextBlock Grid.Column="2" Text="Add a filter to restrict both models to the same slice of data, as in the Power BI filter pane."
                       Style="{StaticResource PageHint}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
            <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Selected}"
                    Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="_Model A column" Target="{Binding ElementName=LeftColumn}" Padding="0,0,0,2" />
                                <ComboBox x:Name="LeftColumn" ItemsSource="{Binding ColumnsA}" SelectedItem="{Binding LeftColumn}" IsEditable="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Same filter on model _B column" Target="{Binding ElementName=RightColumn}" Padding="0,0,0,2" />
                                <ComboBox x:Name="RightColumn" ItemsSource="{Binding ColumnsB}" SelectedItem="{Binding RightColumn}" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,4,0,4">
                            <TextBlock Text="Filter type" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <RadioButton Content="Ba_sic filtering" IsChecked="{Binding IsBasic}" GroupName="FilterType" />
                            <RadioButton Content="Ad_vanced filtering" IsChecked="{Binding IsAdvanced}" GroupName="FilterType" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Label Content="_Description (shown in the Excel export)" Target="{Binding ElementName=Meaning}" Padding="0,0,0,2" />
                        <TextBox x:Name="Meaning" Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Issues}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding Issues, Converter={StaticResource NullToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <Grid>
                        <!-- Basic filtering -->
                        <DockPanel Visibility="{Binding IsBasic, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel DockPanel.Dock="Top">
                                <RadioButton Content="_Is (keep the selected values)" IsChecked="{Binding Exclude, Converter={StaticResource InverseBool}}" GroupName="BasicMode" />
                                <RadioButton Content="Is _not (remove the selected values)" IsChecked="{Binding Exclude}" GroupName="BasicMode" />
                            </WrapPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <ProgressBar DockPanel.Dock="Right" Width="60" Height="6" IsIndeterminate="True" Margin="8,0,0,6"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search values" ToolTip="Search values" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ValuesStatus}" Foreground="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBox Width="160" Text="{Binding ManualValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                             AutomationProperties.Name="Value to add" ToolTip="Type a value (dates as yyyy-mm-dd) and Add" />
                                    <Button Content="Add value" Command="{Binding AddManualValueCommand}" Margin="0" MinWidth="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Select all shown" Command="{Binding SelectAllShownCommand}" MinWidth="0" Margin="0,0,6,0" />
                                    <Button Content="Clear" Command="{Binding ClearSelectionCommand}" MinWidth="0" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Values}" AutomationProperties.Name="Values"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="0" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Advanced filtering -->
                        <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Show items when the value" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Condition1Options}" SelectedItem="{Binding Condition1}" AutomationProperties.Name="First condition" />
                                <TextBox Grid.Column="2" Text="{Binding Condition1Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Condition1NeedsValue}" AutomationProperties.Name="First condition value" />
                            </Grid>
                            <WrapPanel Margin="0,2,0,2">
                                <RadioButton Content="A_nd" IsChecked="{Binding JoinAnd}" GroupName="Join" />
                                <RadioButton Content="_Or" IsChecked="{Binding JoinOr}" GroupName="Join" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Condition2Options}" SelectedItem="{Binding Condition2}" AutomationProperties.Name="Second condition" />
                                <TextBox Grid.Column="2" Text="{Binding Condition2Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Condition2NeedsValue}" AutomationProperties.Name="Second condition value" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Text="Numbers use '.' as decimal separator; dates are written yyyy-mm-dd (optionally with hh:mm:ss). Text matching is not case-sensitive. 'is' never treats BLANK as 0." />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
