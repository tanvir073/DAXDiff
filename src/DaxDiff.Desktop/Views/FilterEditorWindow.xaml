<Window x:Class="DaxDiff.Desktop.Views.FilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DaxDiff.Desktop.Resources;assembly=DaxDiff.Presentation"
        Title="{Binding Title}" Width="980" Height="660" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource CloudBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource TextFont}" FontSize="{StaticResource BaseFontSize}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="24,20">
        <!-- Apply / Cancel -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{x:Static res:Ui.Filter_Cancel}" IsCancel="True" Margin="0,0,8,0" MinWidth="96" />
                <Button Content="{x:Static res:Ui.Filter_Apply}" IsDefault="True" Click="Apply_Click" Style="{StaticResource PrimaryButton}" Margin="0" MinWidth="96" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                       Text="{x:Static res:Ui.Filter_Intro}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter list -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Ui.Filter_ListTitle}" Style="{StaticResource CardTitle}" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="{x:Static res:Ui.Filter_Add}" Command="{Binding AddFilterCommand}" Style="{StaticResource SecondaryButton}" />
                    <Button Content="{x:Static res:Ui.Filter_Remove}" Command="{Binding RemoveFilterCommand}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                           Text="{x:Static res:Ui.Filter_ConnectFirst}"
                           Visibility="{Binding ModelsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{x:Static res:Ui.Filter_Filters}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource MutedText}" TextTrimming="CharacterEllipsis">
                                    <Run Text="A: " /><Run Text="{Binding LeftColumn, Mode=OneWay, TargetNullValue='–'}" />
                                    <Run Text="   B: " /><Run Text="{Binding RightColumn, Mode=OneWay, TargetNullValue='–'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Issues}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding Issues, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Selected filter -->
            <TextBlock Grid.Column="2" Text="{x:Static res:Ui.Filter_Empty}"
                       Style="{StaticResource PageHint}" Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
            <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Selected}"
                    Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="{x:Static res:Ui.Filter_LeftColumn}" Target="{Binding ElementName=LeftColumn}" Padding="0,0,0,2" />
                                <ComboBox x:Name="LeftColumn" ItemsSource="{Binding ColumnsA}" SelectedItem="{Binding LeftColumn}" IsEditable="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="{x:Static res:Ui.Filter_RightColumn}" Target="{Binding ElementName=RightColumn}" Padding="0,0,0,2" />
                                <ComboBox x:Name="RightColumn" ItemsSource="{Binding ColumnsB}" SelectedItem="{Binding RightColumn}" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,4,0,4">
                            <TextBlock Text="{x:Static res:Ui.Filter_Type}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <Border Style="{StaticResource SegmentGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="{x:Static res:Ui.Filter_Basic}" IsChecked="{Binding IsBasic}" GroupName="FilterType" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{x:Static res:Ui.Filter_Advanced}" IsChecked="{Binding IsAdvanced}" GroupName="FilterType" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Label Content="{x:Static res:Ui.Filter_Description}" Target="{Binding ElementName=Meaning}" Padding="0,0,0,2" />
                        <TextBox x:Name="Meaning" Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Issues}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding Issues, Converter={StaticResource NullToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <Grid>
                        <!-- Basic filtering -->
                        <DockPanel Visibility="{Binding IsBasic, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel DockPanel.Dock="Top">
                                <RadioButton Content="{x:Static res:Ui.Filter_Is}" IsChecked="{Binding Exclude, Converter={StaticResource InverseBool}}" GroupName="BasicMode" />
                                <RadioButton Content="{x:Static res:Ui.Filter_IsNot}" IsChecked="{Binding Exclude}" GroupName="BasicMode" />
                            </WrapPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <ProgressBar DockPanel.Dock="Right" Width="60" Height="6" IsIndeterminate="True" Margin="8,0,0,6"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static res:Ui.Filter_SearchValues}" ToolTip="{x:Static res:Ui.Filter_SearchValues}" Tag="{x:Static res:Ui.Filter_SearchValues}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ValuesStatus}" Foreground="{DynamicResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <!-- Wraps, so longer labels (Swedish) move the manual entry to its own line instead of overlapping. -->
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <Button Content="{x:Static res:Ui.Filter_SelectAllShown}" Command="{Binding SelectAllShownCommand}" Margin="0,0,6,0" />
                                    <Button Content="{x:Static res:Ui.Filter_Clear}" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding SelectedCountText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBox Width="160" Text="{Binding ManualValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                             AutomationProperties.Name="{x:Static res:Ui.Filter_ValueToAdd}" ToolTip="{x:Static res:Ui.Filter_ValueToAddTip}" Tag="{x:Static res:Ui.Filter_TypeValue}" />
                                    <Button Content="{x:Static res:Ui.Filter_AddValue}" Command="{Binding AddManualValueCommand}" Margin="0" />
                                </StackPanel>
                            </WrapPanel>
                            <ListBox ItemsSource="{Binding Values}" AutomationProperties.Name="{x:Static res:Ui.Filter_Values}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" Margin="0" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Advanced filtering -->
                        <StackPanel Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:Ui.Filter_ShowWhen}" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Condition1Options}" SelectedItem="{Binding Condition1}" AutomationProperties.Name="{x:Static res:Ui.Filter_Condition1}" />
                                <TextBox Grid.Column="2" Text="{Binding Condition1Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Condition1NeedsValue}" AutomationProperties.Name="{x:Static res:Ui.Filter_Condition1Value}" />
                            </Grid>
                            <WrapPanel Margin="0,2,0,2">
                                <RadioButton Content="{x:Static res:Ui.Filter_And}" IsChecked="{Binding JoinAnd}" GroupName="Join" />
                                <RadioButton Content="{x:Static res:Ui.Filter_Or}" IsChecked="{Binding JoinOr}" GroupName="Join" />
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Condition2Options}" SelectedItem="{Binding Condition2}" AutomationProperties.Name="{x:Static res:Ui.Filter_Condition2}" />
                                <TextBox Grid.Column="2" Text="{Binding Condition2Value, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Condition2NeedsValue}" AutomationProperties.Name="{x:Static res:Ui.Filter_Condition2Value}" />
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,8,0,0"
                                       Text="{x:Static res:Ui.Filter_InputHint}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
