<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds the DAXDiff MSI from a self-contained publish. Run scripts/package.ps1 rather than building this directly. -->
  <PropertyGroup>
    <OutputName>DAXDiff-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildThisFileDirectory)..\publish\app</AppDir>
    <DefineConstants>AppDir=$(AppDir);ProductVersion=$(Version);ToolsDir=$(MSBuildThisFileDirectory)..\tools</DefineConstants>  </PropertyGroup>
</Project>
