<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds the DAXDiff MSI from a self-contained publish. Run scripts/package.ps1 rather than building this directly. -->
  <PropertyGroup>
    <OutputName>DAXDiff-$(Version)-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildThisFileDirectory)..\publish\app</AppDir>
    <!-- Windows Installer versions are numeric only, so a pre-release suffix (-beta.1) is left out of ProductVersion. -->
    <DefineConstants>AppDir=$(AppDir);ProductVersion=$(VersionPrefix);ToolsDir=$(MSBuildThisFileDirectory)..\tools</DefineConstants>
  </PropertyGroup>
</Project>
